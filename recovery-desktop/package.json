{
  "name": "recovery-desktop",
  "version": "0.1.0",
  "description": "Read-only cross-platform deleted-file recovery utility",
  "author": {
    "name": "Recovery Desk contributors",
    "email": "maintainers@example.invalid"
  },
  "homepage": "https://github.com/Kevin-boss/Kevin-boss",
  "repository": "https://github.com/Kevin-boss/Kevin-boss",
  "private": true,
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "package": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.recoverydesk.app",
    "productName": "Recovery Desk",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "maintainers@example.invalid"
    }
  }
}
